# RescueRelay root environment for docker-compose (Postgres service).
# Copy to .env at the repo root to override the defaults.
# App settings live in backend/.env.example and frontend/.env.example;
# copy those to backend/.env and frontend/.env for non-Docker runs.
POSTGRES_USER=rescuerelay
POSTGRES_PASSWORD=rescuerelay
POSTGRES_DB=rescuerelay

# Required by docker compose: the backend refuses to start without it.
# Set a unique value of at least 32 characters. Do not commit the real secret.
JWT_SECRET=
