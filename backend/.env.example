# Copy to backend/.env and adjust. Names match backend/app/core/config.py.
# Docker compose overrides DATABASE_URL to point at the "db" service.
DATABASE_URL=postgresql+psycopg://rescuerelay:rescuerelay@localhost:5432/rescuerelay
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
DEMO_MODE=true
DISPATCH_OFFER_TIMEOUT_SECONDS=120
MATCHING_SAFETY_BUFFER_MINUTES=10
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=
