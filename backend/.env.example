# Copy to backend/.env and adjust. Names match backend/app/core/config.py.
# Docker compose overrides DATABASE_URL to point at the "db" service.
DATABASE_URL=sqlite:///./data/rescuerelay.db
# Keep DATABASE_URL unchanged to preserve your local database configuration.
# Switch to neon only after pasting the pooled URL below, then restart API/worker.
DATABASE_TARGET=local
NEON_DATABASE_URL=
# Optional direct (non-pooler) URL for Alembic; pooled URL is used when blank.
NEON_DIRECT_DATABASE_URL=
# Example: postgresql://USER:PASSWORD@ep-YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
DEMO_MODE=true
DISPATCH_OFFER_TIMEOUT_SECONDS=120
MATCHING_SAFETY_BUFFER_MINUTES=10
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=
